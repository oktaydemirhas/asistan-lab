# Any OpenAI-compatible chat API with tool calling works.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Forwarding headers (CF-Connecting-IP, X-Forwarded-For, X-Real-IP) are client-controlled.
# Set to 1 only on Vercel or behind your own proxy that overwrites them.
TRUST_PROXY_HEADERS=
# Optional limits (requests per minute)
# ASK_PER_CLIENT_PER_MINUTE=12
# ASK_GLOBAL_PER_MINUTE=120
